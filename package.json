{
  "name": "openchamber-session-usage",
  "version": "0.1.0",
  "private": true,
  "description": "会话级 token / 缓存命中 / 费用面板（OpenChamber 扩展）",
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.0"
    },
    "contributes": {
      "panel": {
        "id": "session-usage",
        "name": "会话用量 / Session Usage",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "会话用量 / Session Usage",
        "height": 128
      },
      "capabilities": [
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "attach": false
    }
  }
}
